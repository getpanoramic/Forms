{
  "name": "Curve Finance Dashboard",
  "short_name": "Curve",
  "start_url": "/Forms/",
  "scope": "/Forms/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "minimal-ui"],
  "background_color": "#f3f4f6",
  "theme_color": "#6366f1",
  "icons": [
    {
      "src": "https://cdn-icons-png.flaticon.com/512/10438/10438069.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Importar CSV",
      "url": "/Forms/",
      "description": "Abrir para importar CSV"
    }
  ],
  "share_target": {
    "action": "/Forms/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "csv_file",
          "accept": ["text/csv", ".csv", "application/csv"]
        }
      ]
    }
  }
}
