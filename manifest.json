{
  "name": "Curve Finance Dashboard",
  "short_name": "Curve",
  "start_url": "/Forms/",
  "display": "standalone",
  "background_color": "#f3f4f6",
  "theme_color": "#10b981",
  "icons": [
    {
      "src": "icon.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "/Forms/",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "csv_file",
          "accept": [
            "text/csv",
            "text/plain",
            "text/comma-separated-values",
            "application/csv",
            "application/octet-stream",
            ".csv"
          ]
        }
      ]
    }
  }
}
